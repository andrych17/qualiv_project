        <mxCell id="f21" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="This same check runs for a meeting room, a piece of equipment, or a person&#39;s own time — nothing ever gets booked twice by accident, whether it&#39;s a one-time meeting or a recurring weekly call." vertex="1">
