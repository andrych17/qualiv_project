<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00Z" agent="node-script" version="24.7.5" type="device">
  <diagram id="schedule-flow" name="SCHEDULE - Booking Something (plain language)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1272" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="ftitle" value="How Nothing Gets Double-Booked" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-70" width="1000" height="36" as="geometry"/></mxCell>
<mxCell id="fsub" value="Plain-language walkthrough of booking a meeting, from picking a time to it showing up on everyone's calendar" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-32" width="1000" height="24" as="geometry"/></mxCell>
<mxCell id="f2" value="Someone Wants to Book
a Meeting or Set a Deadline" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="f3" value="They Pick a Time, Add People,
and Choose a Room or Piece of Equipment" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="f4" value="Is Everyone and
Everything Actually Free
at That Time?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="f5" value="They're Told Exactly What's
Conflicting and Asked to Pick Another Time" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="f6" value="The Booking Is Confirmed
and Appears on Everyone's Calendar" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="f7" value="Does It
Repeat?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="520" y="570" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="f8" value="It's Set Up to Repeat —
Any Single Occurrence Can Still Be
Moved or Skipped Without Breaking the Series" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="f9" value="A Video Call Link Is Attached
Automatically, If Needed" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="960" y="570" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="f10" value="Everyone Can See It in Their
Own Phone Calendar App Too" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="500" y="850" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f13" value="No — conflict found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f14" value="Yes, all clear" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="f4" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f15" value="try again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="f5" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f17" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f18" value="No, one-off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f7" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f8" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f21" value="This same check runs for a meeting room, a piece of equipment, or a
person's own time — nothing ever gets booked twice by accident, whether
it's a one-time meeting or a recurring weekly call." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="460" height="90" as="geometry"/></mxCell>
<mxCell id="f22" value="A weekly call series doesn't have to be all-or-nothing — one occurrence
can be moved or cancelled (say, for a public holiday) without touching
any of the others." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="710" width="460" height="80" as="geometry"/></mxCell>
<mxCell id="f23" value="The video link isn't tied to one vendor — it works with whichever
conferencing tool is configured, or someone can just paste their own link." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="f24" value="This works even for a client who hasn't bought any other part of the
platform — a calendar that prevents double-booking and syncs to your
phone is useful entirely on its own." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="700" height="70" as="geometry"/></mxCell>
<mxCell id="flegtitle" value="Legend" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="200" height="24" as="geometry"/></mxCell>
<mxCell id="f25" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1084" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f26" value="Normal step in booking" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1081" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="f27" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1116" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f28" value="A recurring series being set up" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1113" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="f29" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1148" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f30" value="Confirmed and visible everywhere" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1145" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="f31" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f32" value="Blocked — a conflict was found" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1177" width="480" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
