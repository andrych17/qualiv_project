<mxCell id="c325" value="WNE Module — Entity Relationship Diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="1000" height="40" as="geometry"/></mxCell>
<mxCell id="c326" value="23 tables + 1 view: Workflow Engine (definition/version/step/transition/SLA + durable instance execution) and Notification Module (preferences, delivery, retry/DLQ, observability). Zero dependency on any other module — the only external reference anywhere is Laravel's own users table." style="text;html=1;fontSize=13;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-20" width="1700" height="40" as="geometry"/></mxCell>
<mxCell id="c327" value="Legend (colors match DESIGN.md tokens)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1282" width="320" height="24" as="geometry"/></mxCell>
<mxCell id="c328" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A5563;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c329" value="Master / lookup (categories, channel types, configs, templates)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1309" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c330" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5FBF;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1338" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c331" value="Workflow Definition / Version / Step / Transition / SLA rules" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1335" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c332" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B4FCF;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1364" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c333" value="Workflow Instance Execution (instances, tasks, escalation, webhooks, callbacks, audit)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1361" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c334" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B5760A;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c335" value="Notification transaction (preferences, delivery, retry/DLQ, observability, digest)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1387" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c336" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8A8F98;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1416" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c337" value="External (Laravel users — the ONLY external table this module references)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1413" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c338" value="FK* = references public.users(id) — the only cross-schema reference anywhere in this module (§5 &quot;feature-flag independence&quot;: WNE assumes nothing else is installed, not even SYSCONFIG.groups). wrkflow_instance_steps.assigned_team_id and msg_notifications.recipient_type/recipient_id are deliberately informational BIGINT/VARCHAR columns, never a real FK — WNE resolves roles/teams/partners only via a read through the owning module's facade. subject_type/subject_id (wrkflow_instances, msg_notifications) are the same platform-wide polymorphic pointer pattern, informational only. wrkflow_tasks is a VIEW over wrkflow_instance_steps, not a physical table, so it can never drift from the actual execution state. wrkflow_audit_logs and msg_delivery_events are append-only (comment-only immutability, no blocking trigger, matching the platform's general audit-log convention)." style="text;html=1;fontSize=11;fontColor=#4A5563;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1462" width="1700" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
