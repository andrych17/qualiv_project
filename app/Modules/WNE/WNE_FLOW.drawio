        </mxCell>
        <mxCell id="f6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" value="Do They Act in Time?" vertex="1">
          <mxGeometry height="100" width="300" x="530" y="630" as="geometry" />
