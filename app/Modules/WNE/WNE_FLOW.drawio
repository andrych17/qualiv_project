        </mxCell>
        <mxCell id="f8" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="They Approve or Reject, with a Reason If They Want" vertex="1">
