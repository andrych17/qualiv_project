          </mxGeometry>
        </mxCell>
        <mxCell id="f18" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="The same engine handles every approval in the whole platform — a leave request, a purchase order, a big invoice, a deed signing — so &quot;what&#39;s waiting on me&quot; always looks and works the same way, everywhere." vertex="1">
          <mxGeometry height="80" width="460" x="1000" y="270" as="geometry" />
        </mxCell>
        <mxCell id="f19" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every person controls how they want to be reached — which channels, and quiet hours where non-urgent messages wait until morning. Security alerts always get through regardless of those settings." vertex="1">
          <mxGeometry height="80" width="460" x="1000" y="510" as="geometry" />
        </mxCell>
        <mxCell id="f20" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="If a task sits too long, it doesn&#39;t just get reassigned silently — a backup person is added alongside the original owner, and everyone can see why, so nothing quietly falls off someone&#39;s plate without them knowing." vertex="1">
          <mxGeometry height="90" width="460" x="1000" y="630" as="geometry" />
        </mxCell>
        <mxCell id="f21" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="If a message fails to send, it&#39;s retried automatically on a backoff schedule; if it still fails, it&#39;s never just dropped — it lands somewhere an admin can see and manually resend." vertex="1">
          <mxGeometry height="70" width="480" x="440" y="961" as="geometry" />
        </mxCell>
        <mxCell id="flegtitle" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" value="Legend" vertex="1">
