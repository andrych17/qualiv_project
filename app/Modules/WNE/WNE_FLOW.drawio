        <mxCell id="f3" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="The Right Person Is Found Automatically — by Name, Role, or Team" vertex="1">
          <mxGeometry height="70" width="360" x="500" y="270" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="It Shows Up in Their &quot;Waiting on Me&quot; List" vertex="1">
          <mxGeometry height="70" width="360" x="500" y="390" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="They&#39;re Notified — Email, In-App, or Text, Based on Their Own Preferences" vertex="1">
