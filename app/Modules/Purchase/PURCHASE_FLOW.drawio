<mxCell id="ftitle" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" value="How a Purchase Gets From &quot;We Need This&quot; to &quot;It&#39;s Paid For&quot;" vertex="1"><mxGeometry x="40" y="36" width="1000" height="36" as="geometry"/></mxCell>
<mxCell id="fsub" parent="1" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" value="Plain-language walkthrough of the procure-to-pay journey, from requisition through the three-way match" vertex="1"><mxGeometry x="40" y="74" width="1000" height="24" as="geometry"/></mxCell>
