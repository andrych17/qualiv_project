<mxCell id="note1" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A supplier is never a separate list — they are the same Partner registry CRM already keeps, just wearing a Vendor hat." vertex="1"><mxGeometry x="900" y="40" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="note2" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="The purchase order cannot be silently edited once sent — any change becomes a tracked, numbered revision, keeping a clean audit trail." vertex="1"><mxGeometry x="900" y="650" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="note3" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Purchase decides whether a bill is legitimate; Accounting separately decides when to actually pay it — two different questions, two different owners." vertex="1"><mxGeometry x="900" y="1220" width="420" height="90" as="geometry"/></mxCell>
