<mxCell id="c491" value="Payroll Module — Entity Relationship Diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="c492" value="42 tables: Setup/Master, versioned Indonesian statutory rule tables (PPh21/BPJS/Severance), the employee profile + run engine core, per-run statutory calculation detail, payroll inputs (overtime/loans/reimbursement), payment batching, and audit." style="text;html=1;fontSize=13;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-20" width="1600" height="40" as="geometry"/></mxCell>
