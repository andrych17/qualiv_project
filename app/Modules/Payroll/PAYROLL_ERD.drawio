<mxCell id="c501" value="Statutory calculation detail (PPh21, BPJS, THR, Severance — per run line)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1687" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c502" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7F5C;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1716" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c503" value="Payroll Inputs (overtime, variable earnings, commission, reimbursement, loans, advances)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1713" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c504" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0E7C86;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1742" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c505" value="Payment batching, bank file export, reconciliation" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1739" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c506" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C1332B;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1768" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c507" value="Audit trail (append-only)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1765" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c508" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8A8F98;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1794" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c509" value="External (HCM.employees — hard dependency, Laravel users)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1791" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c510" value="FK* = references public.users(id) or &quot;HCM&quot;.employees(id), outside this module's schema. HCM is Payroll's only HARD dependency in the platform (§1/§5) — unlike every other cross-module relation here, Payroll does not degrade gracefully without it. employee_payroll_profiles never copies name/employment-status/tenure — those are read live from HCM.employees at calculation time. ptkp_status_code/ter_category are stored as plain codes, never a pinned FK to one versioned rule row — the calculation engine always resolves &quot;whichever version was effective on the run's period date,&quot; never &quot;whatever's latest,&quot; so a mid-year regulation change never retroactively alters an already-paid period. payroll_run_lines is enforced locked-after-paid by a real Postgres trigger (like INVENTORY.stock_ledger and LEGAL.protocol_entries) — corrections must go through a Payroll Adjustment run, never a direct edit." style="text;html=1;fontSize=11;fontColor=#4A5563;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1840" width="1650" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
