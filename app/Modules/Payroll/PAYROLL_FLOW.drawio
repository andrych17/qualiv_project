        </mxCell>
        <mxCell id="fsub" parent="1" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" value="Plain-language walkthrough of a monthly pay run, from gathering the numbers to money landing in an account" vertex="1">
