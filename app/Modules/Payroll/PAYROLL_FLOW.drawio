          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f21" edge="1" parent="1" source="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="f11" value="needs a later correction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f22" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Tax and BPJS rates are never hardcoded into the software — they&#39;re stored as data that updates whenever the government changes them, so a rate change is a data entry, not a wait for a new software release." vertex="1">
          <mxGeometry height="80" width="460" x="1000" y="390" as="geometry" />
        </mxCell>
        <mxCell id="f23" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A payslip is never allowed to show someone owing money. If deductions would exceed earnings, that person&#39;s pay is flagged and held back for review before the run can be approved — nothing goes out wrong by accident." vertex="1">
          <mxGeometry height="80" width="460" x="1000" y="630" as="geometry" />
        </mxCell>
        <mxCell id="f24" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Once a run is paid, it becomes permanently locked — literally impossible to quietly edit. If a mistake is found later, it&#39;s corrected with a new, linked entry, so there&#39;s always a clear paper trail of exactly what changed." vertex="1">
          <mxGeometry height="80" width="460" x="1000" y="900" as="geometry" />
        </mxCell>
        <mxCell id="f25" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Payroll only works for tenants that also use the HR module, since employee identity and tenure live there — this avoids ever having two different systems calculating the same person&#39;s legal entitlements differently." vertex="1">
          <mxGeometry height="70" width="440" x="40" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="flegtitle" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" value="Legend" vertex="1">
