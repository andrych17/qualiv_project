        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="A Draft Payslip Is Created for Every Employee" vertex="1">
          <mxGeometry height="70" width="360" x="500" y="510" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" value="Does Anyone&#39;s Pay Come Out Negative?" vertex="1">
          <mxGeometry height="100" width="300" x="530" y="630" as="geometry" />
        </mxCell>
        <mxCell id="f7" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="That Person&#39;s Entries Are Reviewed and Fixed" vertex="1">
          <mxGeometry height="70" width="360" x="40" y="770" as="geometry" />
        </mxCell>
        <mxCell id="f8" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="A Manager Reviews and Approves the Whole Run" vertex="1">
          <mxGeometry height="70" width="360" x="500" y="770" as="geometry" />
        </mxCell>
        <mxCell id="f9" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Payment Is Sent to Each Employee&#39;s Bank Account" vertex="1">
          <mxGeometry height="70" width="360" x="500" y="900" as="geometry" />
        </mxCell>
        <mxCell id="f10" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="The Pay Run Is Now Locked — No More Silent Edits" vertex="1">
