        <mxCell id="f4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Income Tax and BPJS Contributions Are Calculated Automatically, Per Employee" vertex="1">
