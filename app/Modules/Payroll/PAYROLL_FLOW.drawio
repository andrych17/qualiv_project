        <mxCell id="f3" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="The System Gathers Everything — Salary, Overtime, Bonuses, Loan Payments Due" vertex="1">
