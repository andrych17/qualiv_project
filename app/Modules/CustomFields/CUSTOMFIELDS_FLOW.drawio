        <mxCell id="note2" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every screen that uses that kind of record (a Case, a Product, an Employee) automatically gets the new field — one setup, everywhere it&#39;s needed." vertex="1">
