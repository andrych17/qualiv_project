        <mxCell id="note1" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Turning on a field is a data-entry task now, not a code change — no waiting on a developer or a release." vertex="1">
