        <mxCell id="note1" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every role a person or company can hold — Client, Vendor, Referral Partner — can be renamed to match how a firm actually talks about its relationships, with no extra development work." vertex="1"><mxGeometry x="900" y="786" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A record is never silently thrown away — even a duplicate entry gets carefully combined with a full paper trail, not erased, so nothing important is ever lost." vertex="1"><mxGeometry x="900" y="1026" width="420" height="80" as="geometry"/></mxCell>
