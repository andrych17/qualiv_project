<mxCell id="d157" value="Note: 3.0 After Sales Service is triggered by a Vertical Module (e.g. a closed Legal Case) but CRM stores only an informational subject_type / subject_id pointer -- never a real foreign key into a vertical schema. This is the same loose-coupling seam WNE uses for workflow subjects." style="text;html=1;fontSize=11;fontColor=#4A5563;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="950" height="60" as="geometry"/></mxCell>
