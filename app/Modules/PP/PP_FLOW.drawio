        <mxCell id="ftitle" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" value="How a Production Plan Survives Contact With Reality" vertex="1">
          <mxGeometry height="36" width="1100" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="fsub" parent="1" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" value="Plain-language walkthrough of turning September&#39;s sales orders into a shop-floor-ready production order, and what happens when material or machine time falls short" vertex="1">
