        <mxCell id="note1" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="The overload check runs the same way whether it&#39;s an assembly line bolting metal together or a mixing tank blending chemicals — one planning engine, two production models underneath." vertex="1">
          <mxGeometry height="90" width="420" x="920" y="460" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A &quot;what if&quot; version of this entire check can run inside its own scenario first — demand +15%, a machine down for five days — without ever touching the real plan, real inventory, or real orders." vertex="1">
          <mxGeometry height="100" width="420" x="920" y="610" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="This whole plan is useful on its own even before a shop floor system exists to receive the released order — knowing what to buy and when to buy it doesn&#39;t wait for execution software." vertex="1">
          <mxGeometry height="100" width="420" x="920" y="900" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="&quot;Released&quot; here means a planned order becomes a real order in whichever system executes it: a production order, a purchase requisition, or a stock transfer — never a second copy of the plan." vertex="1">
