        <mxCell id="note1" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every customer is the same Partner record CRM already keeps — Sales never re-enters or duplicates who someone is." vertex="1">
