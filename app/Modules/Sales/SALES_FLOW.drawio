        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Sales never keeps its own invoice or payment table. Accounting is the one ledger everyone hands billing requests to, so every invoice is tax-correct by construction." vertex="1">
