<mxCell id="note1" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every customer is the same Partner record CRM already keeps — Sales never re-enters or duplicates who someone is." vertex="1"><mxGeometry x="900" y="40" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="note2" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Sales never keeps its own invoice or payment table. Accounting is the one ledger everyone hands billing requests to, so every invoice is tax-correct by construction." vertex="1"><mxGeometry x="900" y="990" width="420" height="90" as="geometry"/></mxCell>
<mxCell id="note3" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A cancelled or unpaid order never triggers commission — only revenue that is actually invoiced and paid counts." vertex="1"><mxGeometry x="900" y="1210" width="420" height="80" as="geometry"/></mxCell>
