        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A cancelled or unpaid order never triggers commission — only revenue that is actually invoiced and paid counts." vertex="1">
