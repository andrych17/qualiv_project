        </mxCell>
        <mxCell id="f19" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A company only sees the sections it&#39;s actually paying for — this switch can only hide something already included in their plan, never add something extra on its own." vertex="1">
          <mxGeometry height="60" width="420" x="900" y="350" as="geometry" />
        </mxCell>
        <mxCell id="f20" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every team (e.g. Notaries vs. Paralegals) can have different access to the same screen — one might edit, the other only view. No code change needed to add a new team or adjust its access." vertex="1">
          <mxGeometry height="60" width="420" x="900" y="500" as="geometry" />
        </mxCell>
        <mxCell id="f21" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Example: reminder lead time defaults to 7 days for everyone in Legal, 3 days for the Notaries team, 1 day for one specific person who asked for it — all three rules can coexist." vertex="1">
          <mxGeometry height="80" width="420" x="900" y="690" as="geometry" />
        </mxCell>
        <mxCell id="f22" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Small dropdown lists (like gender or a status list) are stored as simple data too — an admin can add or reorder an option in minutes, without asking a developer to change any code." vertex="1">
          <mxGeometry height="70" width="420" x="900" y="900" as="geometry" />
        </mxCell>
