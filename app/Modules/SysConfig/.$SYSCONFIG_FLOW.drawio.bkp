<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00Z" agent="node-script" version="24.7.5" type="device">
  <diagram id="sysconfig-flow" name="SYSCONFIG - Access &amp; Settings Explainer (plain language)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1182" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="ftitle" value="What Decides What a Staff Member Sees" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-70" width="900" height="36" as="geometry"/></mxCell>
<mxCell id="fsub" value="Plain-language walkthrough of the three checks behind every screen, menu, and setting" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-32" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="f2" value="Staff Member Logs In" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="f3" value="System Looks Up
Which Team(s) They Belong To" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="f4" value="Is This Section (e.g. Payroll,
Legal) Turned On for
This Company?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="f5" value="That Whole Section
Stays Hidden" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="f6" value="Does Their Team Have
Permission to View / Edit
This Screen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="f7" value="That Menu Item
Stays Hidden" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="f8" value="Apply This Person's Settings —
Most Specific Wins" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="580" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f9" value="Company Default  →  Team Override  →  Personal Override
(whichever is most specific to this person)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="f10" value="Screen Shows Exactly
What This Person Should See —
Nothing More, Nothing Less" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="790" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f13" value="Yes, it's on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="f4" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f15" value="Yes, they can see it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="f6" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f16" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f19" value="A company only sees the sections it's actually paying for — this
switch can only hide something already included in their plan,
never add something extra on its own." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="260" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="f20" value="Every team (e.g. Notaries vs. Paralegals) can have different
access to the same screen — one might edit, the other only view.
No code change needed to add a new team or adjust its access." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="f21" value="Example: reminder lead time defaults to 7 days for everyone in
Legal, 3 days for the Notaries team, 1 day for one specific person
who asked for it — all three rules can coexist." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="580" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="f22" value="Small dropdown lists (like gender or a status list) are stored
as simple data too — an admin can add or reorder an option in
minutes, without asking a developer to change any code." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="flegtitle" value="Legend" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="200" height="24" as="geometry"/></mxCell>
<mxCell id="f23" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="954" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f24" value="Normal step in checking access" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="951" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f25" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f26" value="Applying a setting or override" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="983" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f27" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1018" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f28" value="What the person finally sees" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1015" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f29" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f30" value="Hidden — not available to this person" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1047" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f31" value="Every change to a permission, setting, or on/off switch is automatically
recorded — who changed what, and when — so nothing here is ever a silent edit." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1092" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
