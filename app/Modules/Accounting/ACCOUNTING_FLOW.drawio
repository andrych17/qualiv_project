  <diagram id="accounting-flow" name="ACCOUNTING - Booking a Transaction (plain language)">
    <mxGraphModel dx="1252" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
