          <mxGeometry height="100" width="280" x="510" y="260" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="We Send the Client an Invoice" vertex="1">
          <mxGeometry height="70" width="340" x="60" y="370" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="We Record What We Owe a Vendor" vertex="1">
          <mxGeometry height="70" width="340" x="920" y="370" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Tax Is Worked Out Automatically (VAT added, or withholding deducted)" vertex="1">
          <mxGeometry height="70" width="340" x="480" y="530" as="geometry" />
        </mxCell>
        <mxCell id="f7" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="The Amount Is Booked in the Company&#39;s Books (one balanced entry, always)" vertex="1">
          <mxGeometry height="80" width="340" x="480" y="650" as="geometry" />
        </mxCell>
        <mxCell id="f8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" value="Has It Been Paid Yet?" vertex="1">
          <mxGeometry height="100" width="280" x="510" y="780" as="geometry" />
        </mxCell>
        <mxCell id="f9" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="It Stays Open and Tracked (shows up in the aging report)" vertex="1">
          <mxGeometry height="70" width="340" x="60" y="930" as="geometry" />
        </mxCell>
        <mxCell id="f10" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="It&#39;s Marked Settled and the Books Reconcile Automatically" vertex="1">
          <mxGeometry height="70" width="340" x="920" y="930" as="geometry" />
        </mxCell>
        <mxCell id="f11" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Everything Posted Feeds Into the Financial Reports" vertex="1">
          <mxGeometry height="70" width="340" x="480" y="1090" as="geometry" />
        </mxCell>
