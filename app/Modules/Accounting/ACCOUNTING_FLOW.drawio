          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f18" edge="1" parent="1" source="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" target="f8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f19" edge="1" parent="1" source="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="f9" value="Not yet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f20" edge="1" parent="1" source="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="f10" value="Yes, payment received/sent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f21" edge="1" parent="1" source="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="f8" value="still open">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f22" edge="1" parent="1" source="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" target="f11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f23" edge="1" parent="1" source="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" target="f11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f24" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every entry has to balance to the last cent before it can post — there is exactly one path money can take into the books, whether a person typed it in or another part of the system generated it." vertex="1">
          <mxGeometry height="70" width="430" x="950" y="530" as="geometry" />
        </mxCell>
        <mxCell id="f25" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Indonesian tax rules (VAT, withholding) are applied and the required tax documents are generated automatically — not something staff have to remember to add separately on every invoice or bill." vertex="1">
          <mxGeometry height="70" width="430" x="950" y="650" as="geometry" />
        </mxCell>
        <mxCell id="f26" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="What&#39;s owed to us and what we owe never has to be manually reconciled against the books — they&#39;re always in sync because they&#39;re recorded together, the same moment, not two systems agreeing later." vertex="1">
          <mxGeometry height="80" width="430" x="950" y="770" as="geometry" />
        </mxCell>
        <mxCell id="f27" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Two separate companies under the same firm (e.g. the operating business and a client trust account) always keep fully separate books — nothing from one can accidentally end up in the other&#39;s numbers." vertex="1">
          <mxGeometry height="80" width="430" x="920" y="880" as="geometry" />
        </mxCell>
        <mxCell id="f28" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Nothing posted is ever silently edited. A correction is always a new, linked entry that reverses the original — so the full history stays intact for an audit or a tax review." vertex="1">
          <mxGeometry height="70" width="430" x="60" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="flegtitle" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" value="Legend" vertex="1">
          <mxGeometry height="24" width="200" x="40" y="1160" as="geometry" />
        </mxCell>
