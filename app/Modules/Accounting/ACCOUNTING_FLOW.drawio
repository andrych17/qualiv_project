<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00Z" agent="node-script" version="24.7.5" type="device">
  <diagram id="accounting-flow" name="ACCOUNTING - Booking a Transaction (plain language)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="ftitle" value="How Money Coming In or Going Out Gets Booked" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-70" width="1000" height="36" as="geometry"/></mxCell>
<mxCell id="fsub" value="Plain-language walkthrough of an invoice or bill, from being raised to showing up correctly in the books" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-32" width="1000" height="24" as="geometry"/></mxCell>
<mxCell id="f2" value="A Bill Needs to Go Out
(or Come In)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f3" value="Is Money Owed
to Us, or by Us?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="f4" value="We Send the Client an Invoice" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f5" value="We Record What We Owe a Vendor" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f6" value="Tax Is Worked Out Automatically
(VAT added, or withholding deducted)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f7" value="The Amount Is Booked in the Company's Books
(one balanced entry, always)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="540" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="f8" value="Has It Been
Paid Yet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="510" y="670" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="f9" value="It Stays Open and Tracked
(shows up in the aging report)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f10" value="It's Marked Settled
and the Books Reconcile Automatically" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f11" value="Everything Posted Feeds Into
the Financial Reports" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="930" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f13" value="Owed to us" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f14" value="Owed by us" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f3" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f19" value="Not yet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f20" value="Yes, payment received/sent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f8" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f21" value="still open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="f9" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f10" target="f11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f9" target="f11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f24" value="Every entry has to balance to the last cent before it can post —
there is exactly one path money can take into the books, whether
a person typed it in or another part of the system generated it." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="430" height="70" as="geometry"/></mxCell>
<mxCell id="f25" value="Indonesian tax rules (VAT, withholding) are applied and the
required tax documents are generated automatically — not something
staff have to remember to add separately on every invoice or bill." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="430" height="70" as="geometry"/></mxCell>
<mxCell id="f26" value="What's owed to us and what we owe never has to be manually
reconciled against the books — they're always in sync because
they're recorded together, the same moment, not two systems agreeing later." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="950" y="670" width="430" height="80" as="geometry"/></mxCell>
<mxCell id="f27" value="Two separate companies under the same firm (e.g. the operating
business and a client trust account) always keep fully separate books
— nothing from one can accidentally end up in the other's numbers." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="950" y="800" width="430" height="80" as="geometry"/></mxCell>
<mxCell id="f28" value="Nothing posted is ever silently edited. A correction is always a new,
linked entry that reverses the original — so the full history stays
intact for an audit or a tax review." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="700" height="70" as="geometry"/></mxCell>
<mxCell id="flegtitle" value="Legend" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="200" height="24" as="geometry"/></mxCell>
<mxCell id="f29" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1194" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f30" value="Normal step in recording the transaction" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1191" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="f31" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1226" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f32" value="Tax handling, or an item still open/awaiting payment" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1223" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="f33" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1258" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f34" value="Settled and reflected in the reports" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1255" width="480" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
