        <mxCell id="ftitle" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" value="How Money Coming In or Going Out Gets Booked" vertex="1">
          <mxGeometry height="36" width="1000" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="fsub" parent="1" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" value="Plain-language walkthrough of an invoice or bill, from being raised to showing up correctly in the books" vertex="1">
