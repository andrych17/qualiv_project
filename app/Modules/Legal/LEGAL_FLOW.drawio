        <mxCell id="f25" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Nothing about a deed can be quietly changed after signing. If a correction is ever needed, it becomes a brand-new, linked document — the original stays exactly as it was witnessed, forever." vertex="1">
          <mxGeometry height="70" width="460" x="1000" y="390" as="geometry" />
        </mxCell>
        <mxCell id="f26" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="This mirrors the real government rule: a deed legally cannot be finalized until the required land taxes are confirmed paid. The software enforces the same discipline automatically, so nothing slips through by accident." vertex="1">
          <mxGeometry height="80" width="460" x="1000" y="610" as="geometry" />
        </mxCell>
        <mxCell id="f27" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Every signed deed is also recorded, in order, in the firm&#39;s official ledger book — the exact record a Notaris is personally responsible for keeping intact and eventually handing over." vertex="1">
          <mxGeometry height="70" width="460" x="1000" y="910" as="geometry" />
        </mxCell>
        <mxCell id="f28" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A field visit works the same way from a phone at the site — even with poor signal, photos and check-ins are saved and sync automatically once back online." vertex="1">
