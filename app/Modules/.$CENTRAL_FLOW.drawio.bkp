<mxCell id="f19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f22" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f23" value="next month" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f9" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f24" value="Not yet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="f8" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f10" target="f11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f26" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f11" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f27" value="Still not paid
(about 2 weeks late)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="f11" target="f12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f12" target="f13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f13" target="f14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f14" target="f15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f31" value="resumes normal billing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="f15" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f32" value="No payment gateway in the first version — clients pay by bank
transfer and Simon reviews each receipt by hand. This matches how
most small businesses in this market actually pay today." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="260" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="f33" value="Nothing is ever deleted or locked away. A late account can still
be viewed in full at all times — it just can't be edited until
payment is confirmed. This is a deliberate trust-building choice." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="1100" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="f34" value="The number of reminders and how many days before switching to
read-only can be adjusted per client — e.g. a longer grace period
for a strategic early customer — without any engineering work." style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="860" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="flegtitle" value="Legend" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="200" height="24" as="geometry"/></mxCell>
<mxCell id="f35" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1594" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f36" value="Normal step in the billing cycle" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1591" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f37" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1626" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f38" value="Account is active and in good standing" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1623" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f39" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1658" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f40" value="Warning — a payment is due or overdue" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1655" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="f41" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1690" width="34" height="22" as="geometry"/></mxCell>
<mxCell id="f42" value="Account is read-only (view-only, not locked out)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1687" width="420" height="28" as="geometry"/></mxCell>
