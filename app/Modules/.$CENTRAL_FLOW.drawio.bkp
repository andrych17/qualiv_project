<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00Z" agent="node-script" version="24.7.5" type="device">
  <diagram id="central-flow" name="CENTRAL - Client Subscription Journey (plain language)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1782" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="ftitle" value="How a Client's Subscription Works" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-70" width="900" height="36" as="geometry"/></mxCell>
<mxCell id="fsub" value="Plain-language walkthrough of onboarding, monthly billing, and what happens if a payment is late" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-32" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="f2" value="New Client Signs Up" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="f3" value="First Invoice Sent" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="f4" value="Client Pays by Bank Transfer
and Uploads Proof of Payment" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="f5" value="Simon Checks the Receipt
and Confirms Payment" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="f6" value="Account Goes Live" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="f7" value="Every Month: New Invoice Sent" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="620" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="f8" value="Paid Before
the Due Date?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="520" y="720" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="f9" value="Account Stays Active" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="960" y="730" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="f10" value="Reminder Emails Sent
(before, on, and after the due date)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="440" y="860" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="f11" value="Paid After
a Reminder?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="520" y="970" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="f12" value="Account Switches to Read-Only
(client can still see all their data,
just can't make changes)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="420" y="1100" width="440" height="90" as="geometry"/></mxCell>
<mxCell id="f13" value="Client Pays and Uploads Proof
(can do this any time, even read-only)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="420" y="1230" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="f14" value="Simon Confirms Payment" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="420" y="1340" width="440" height="60" as="geometry"/></mxCell>
<mxCell id="f15" value="Account Automatically
Goes Back to Active" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="420" y="1440" width="440" height="70" as="geometry"/></mxCell>
