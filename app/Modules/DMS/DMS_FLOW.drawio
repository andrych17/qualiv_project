<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="dms-flow" name="DMS - Uploading and Retiring a Document (plain language)">
    <mxGraphModel dx="1252" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f1" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" value="What Happens When Someone Uploads and Manages a Document" vertex="1">
          <mxGeometry height="36" width="1000" x="40" y="36" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" value="Plain-language walkthrough from upload, through version updates, to the day a document’s retention period ends" vertex="1">
          <mxGeometry height="24" width="1000" x="40" y="74" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Someone Uploads a File" vertex="1">
          <mxGeometry height="60" width="320" x="500" y="146" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="The System Saves the File Safely and Notes Who Uploaded It" vertex="1">
          <mxGeometry height="70" width="320" x="500" y="256" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" value="Is This a Brand New Document, or a New Version of an Existing One?" vertex="1">
          <mxGeometry height="100" width="280" x="520" y="376" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="A New Document Record Is Created" vertex="1">
          <mxGeometry height="60" width="320" x="80" y="751" as="geometry" />
        </mxCell>
        <mxCell id="f7" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="The Old Copy Is Kept, the New One Becomes Current" vertex="1">
          <mxGeometry height="70" width="360" x="480" y="526" as="geometry" />
        </mxCell>
        <mxCell id="f8" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Nothing Is Ever Thrown Away — Every Past Version Stays Available in History" vertex="1">
          <mxGeometry height="70" width="360" x="480" y="636" as="geometry" />
        </mxCell>
        <mxCell id="f9" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Document Appears in the Library, Ready to Find and Open" vertex="1">
          <mxGeometry height="70" width="360" x="480" y="746" as="geometry" />
        </mxCell>
        <mxCell id="f10" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="A Retention Countdown Starts, Based on the Document’s Type" vertex="1">
          <mxGeometry height="70" width="360" x="480" y="856" as="geometry" />
        </mxCell>
        <mxCell id="f11" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" value="Has the Retention Period Run Out?" vertex="1">
          <mxGeometry height="90" width="240" x="540" y="966" as="geometry" />
        </mxCell>
        <mxCell id="f12" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Document Stays Active, Countdown Keeps Running" vertex="1">
          <mxGeometry height="60" width="300" x="900" y="981" as="geometry" />
        </mxCell>
        <mxCell id="f13" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" value="Is the Document Under Legal Hold?" vertex="1">
          <mxGeometry height="90" width="240" x="540" y="1106" as="geometry" />
        </mxCell>
        <mxCell id="f14" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Action Is Blocked — Nothing Is Deleted, No Matter What the Schedule Says" vertex="1">
          <mxGeometry height="80" width="320" x="900" y="1111" as="geometry" />
        </mxCell>
        <mxCell id="f15" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="A Reviewer Is Notified Before Anything Happens" vertex="1">
          <mxGeometry height="70" width="360" x="480" y="1236" as="geometry" />
        </mxCell>
        <mxCell id="f16" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Reviewer Approves the Configured Action (Notify, Archive, or Delete)" vertex="1">
          <mxGeometry height="80" width="360" x="480" y="1346" as="geometry" />
        </mxCell>
        <mxCell id="f17" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" value="Document Is Archived or Safely Removed, Exactly as Policy Says" vertex="1">
          <mxGeometry height="70" width="360" x="480" y="1466" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;labelBackgroundColor=#FFFFFF;" target="f4" value="">
