        </mxCell>
        <mxCell id="leg43" parent="1" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" value="Retention or legal-hold related step" vertex="1">
          <mxGeometry height="28" width="420" x="86" y="1675" as="geometry" />
        </mxCell>
        <mxCell id="leg44" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="22" width="34" x="40" y="1710" as="geometry" />
        </mxCell>
        <mxCell id="leg45" parent="1" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" value="Blocked or restricted outcome" vertex="1">
          <mxGeometry height="28" width="420" x="86" y="1707" as="geometry" />
