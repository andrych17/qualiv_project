          <mxGeometry height="22" width="34" x="40" y="1614" as="geometry" />
        </mxCell>
        <mxCell id="leg39" parent="1" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" value="Normal step in the document lifecycle" vertex="1">
          <mxGeometry height="28" width="420" x="86" y="1611" as="geometry" />
        </mxCell>
        <mxCell id="leg40" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="22" width="34" x="40" y="1646" as="geometry" />
        </mxCell>
        <mxCell id="leg41" parent="1" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" value="Stored safely / active and in good standing" vertex="1">
          <mxGeometry height="28" width="420" x="86" y="1643" as="geometry" />
        </mxCell>
