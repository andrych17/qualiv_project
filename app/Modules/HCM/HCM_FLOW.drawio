        <mxCell id="f20" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="If this person is later terminated, their record is never deleted — it&#39;s marked terminated and kept, since Indonesian labor law requires employers to retain employment history." vertex="1">
