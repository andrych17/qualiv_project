<mxCell id="c277" value="HCM Module — Entity Relationship Diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="1000" height="40" as="geometry"/></mxCell>
<mxCell id="c278" value="15 tables: Org/Job Structure, Employee identity + Contracts, Leave setup + transactions, and Time &amp; Attendance. All payroll run/payslip data lives in the separate Payroll module." style="text;html=1;fontSize=13;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-20" width="1500" height="24" as="geometry"/></mxCell>
<mxCell id="c279" value="Legend (colors match DESIGN.md tokens)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="320" height="24" as="geometry"/></mxCell>
