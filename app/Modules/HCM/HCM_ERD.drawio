<mxCell id="c281" value="Organization / Job Structure + versioned regional minimum wage" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1393" width="900" height="24" as="geometry"/></mxCell>
