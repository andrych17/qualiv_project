<mxCell id="c284" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B4FCF;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1448" width="24" height="18" as="geometry"/></mxCell>
