<mxCell id="c286" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B5760A;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1474" width="24" height="18" as="geometry"/></mxCell>
