<mxCell id="c288" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8A8F98;strokeColor=#12181F;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="24" height="18" as="geometry"/></mxCell>
<mxCell id="c289" value="External (Laravel users, Payroll's 1:1 extension, informational CRM/Accounting links)" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="1497" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c290" value="FK* = references public.users(id), outside this module's schema. employees.linked_partner_id and org_units.accounting_cost_center_id are deliberately informational-only BIGINT columns, NOT enforced foreign keys — HCM.employees is intentionally a separate table from CRM.partners (§5, different statutory fields and lifecycle rules), and Accounting is an optional install. &quot;PAYROLL&quot;.employee_payroll_profiles is drawn here only to show the reverse-direction relationship: it is a real 1:1 cross-schema FK OWNED BY Payroll pointing INTO HCM.employees.id (Payroll depends on HCM, never the other way) — HCM carries no payroll/tax field of its own (no PTKP status, no payroll group). All payroll run/payslip/THR/severance tables live entirely in the Payroll module's own schema, not here." style="text;html=1;fontSize=11;fontColor=#4A5563;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1546" width="1600" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
