  <diagram id="projects-flow" name="PROJECTS - How a Task Moves From Idea to Done (plain language)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="ftitle" value="How a Task Moves From Idea to Done" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12181F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="900" height="36" as="geometry"/></mxCell>
<mxCell id="fsub" value="Plain-language walkthrough of a task riding the board from creation to completion" style="text;html=1;fontSize=14;fontColor=#4A5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="f2" value="A New Task Is Added" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="146" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="f3" value="It Waits in the To Do Column" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="256" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="f4" value="Someone Is Assigned and Moves It to In Progress" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="366" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f5" value="Has the Due Date Passed While It’s Still Open?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="520" y="486" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="f6" value="The Card Shows an Overdue Warning and Floats to the Top" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBF1E1;strokeColor=#B5760A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="900" y="496" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="f7" value="The Team Keeps Working on It (updates, comments, files attached)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="636" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="f8" value="Is the Work Actually Finished?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12181F;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="520" y="766" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="f9" value="The Card Is Dragged Into the Done Column" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#1F5FBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="906" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="f10" value="Task Is Complete" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F5EF;strokeColor=#1E7F5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="480" y="1006" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="f11" value="Still Untouched a Week Later — Stays Highlighted as Stuck" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C1332B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12181F;" vertex="1" parent="1"><mxGeometry x="900" y="636" width="340" height="80" as="geometry"/></mxCell>
