<mxCell id="fleg3tx" value="Stuck — sitting overdue with nobody on it" style="text;html=1;fontSize=12;fontColor=#12181F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="1253" width="420" height="28" as="geometry"/></mxCell>
