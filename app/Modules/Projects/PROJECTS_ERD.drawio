<mxCell id="cfoot" value="FK* on users.id references a core Laravel table that lives outside the PROJECTS schema (public schema, same tenant DB) — a real, enforced cross-schema foreign key, not merely informational. lead_id/assignee_id/reporter_id/user_id all ON DELETE SET NULL; project_id/issue_id ON DELETE CASCADE. CHECK constraints (not modeled as separate cells) restrict projects.status, issues.type/status/priority to the fixed value sets in PROJECTS_SPECS.md §3B/§3D." style="text;html=1;fontSize=11;fontColor=#4A5563;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="1540" height="56" as="geometry"/></mxCell>
