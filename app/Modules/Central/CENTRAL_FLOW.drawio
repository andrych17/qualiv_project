        <mxCell id="f32" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="No payment gateway in the first version — clients pay by bank transfer and Simon reviews each receipt by hand. This matches how most small businesses in this market actually pay today." vertex="1">
