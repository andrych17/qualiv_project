        <mxCell id="f26" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Nothing is ever &quot;just edited.&quot; Every single change — receiving, moving, selling, or correcting — becomes its own permanent, timestamped entry. If something needs fixing, we add a correcting entry, we never erase history." vertex="1">
          <mxGeometry height="80" width="460" x="950" y="390" as="geometry" />
        </mxCell>
        <mxCell id="f27" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="The system knows what each unit is worth using a consistent accounting method (oldest stock first, or a running average) — so the value on the books is always defensible, not a guess." vertex="1">
          <mxGeometry height="70" width="460" x="960" y="610" as="geometry" />
        </mxCell>
        <mxCell id="f28" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="A stock count never changes the numbers by itself. A mismatch is flagged for a person to review and approve first — nothing silently corrects itself." vertex="1">
          <mxGeometry height="80" width="200" x="1280" y="800" as="geometry" />
        </mxCell>
        <mxCell id="f29" parent="1" style="text;html=1;fontSize=11;fontColor=#4A5563;fontStyle=2;align=left;verticalAlign=top;whiteSpace=wrap;" value="Barcode scanning works the same way at every step — receiving, moving, picking, and counting — so warehouse staff use one familiar motion for everything, with any handheld or camera scanner." vertex="1">
